# =============================================================================
# .env.example — plantilla del entorno local. Copia a .env y rellena.
#   cp .env.example .env
# El .env real NUNCA se commitea (está en .gitignore).
#
# Para sacar los valores reales del entorno de desarrollo:
#   gcloud secrets versions access latest --secret=GEMINI_API_KEY --project=recava-auditor-dev
# =============================================================================

# --- Obligatorio: sin esto la aplicación no arranca (src/config.py aborta) ---
GEMINI_API_KEY=
BIGQUERY_DATASET_ID=recava_agent_audit_qa
BIGQUERY_TABLE_ID=chat_history

# --- Opcional: sin claves de Pinecone el RAG queda desactivado, pero el chat funciona ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=uclm-corpus-roma

# --- Debe coincidir con el modelo con el que se construyó el índice ---
# Cambiarlo sin reindexar rompe la recuperación (ARC-3 en docs/SPEC.md).
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Grafo de conocimiento. Sin NEO4J_PASSWORD, las consultas al grafo se omiten ---
NEO4J_URI=neo4j+s://273d9982.databases.neo4j.io
NEO4J_USERNAME=273d9982
NEO4J_DATABASE=273d9982
NEO4J_PASSWORD=

# --- Proyecto GCP para los clientes de BigQuery y Firestore ---
GOOGLE_CLOUD_PROJECT=recava-auditor-dev
GCLOUD_PROJECT=recava-auditor-dev

# --- Servidor local ---
PORT=8080
FLASK_DEBUG=1

# --- Desarrollo local -------------------------------------------------------
# 1 = usa los emuladores de Firebase para Auth y Firestore, de modo que las
#     pruebas NO tocan los datos reales de usuarios ni de conversaciones.
#     Requiere Java instalado:  brew install --cask temurin
# 0 = habla con el Firestore REAL de recava-auditor-dev. Cuidado: los hilos y
#     el progreso de auditoría que crees serán datos de verdad.
USE_EMULATORS=1

# 1 = no escribe trazas en BigQuery (recomendado en local).
DISABLE_BIGQUERY=1

# Orígenes permitidos. El frontend local se sirve en http://localhost:8000.
CORS_ORIGINS=http://localhost:8000,https://recava-auditor-dev.web.app,https://recava-auditor-dev-panel.web.app
