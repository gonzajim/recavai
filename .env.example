# =============================================================================
# .env.example — plantilla del entorno local. Copia a .env y rellena.
#   cp .env.example .env
# El .env real NUNCA se commitea (está en .gitignore).
#
# Para sacar los valores reales del entorno de desarrollo:
#   gcloud secrets versions access latest --secret=GEMINI_API_KEY --project=recava-auditor-dev
# =============================================================================

# --- Obligatorio: sin esto la aplicación no arranca (src/config.py aborta) ---
GEMINI_API_KEY=
BIGQUERY_DATASET_ID=recava_agent_audit_qa
BIGQUERY_TABLE_ID=chat_history

# --- Opcional: sin claves de Pinecone el RAG queda desactivado, pero el chat funciona ---
PINECONE_API_KEY=
# Índice de la revisión (v2). Tiene prioridad sobre PINECONE_INDEX_NAME.
RAG_INDEX_NAME=recavai-corpus-v2
PINECONE_INDEX_NAME=recavai-corpus-v2

# --- Índice, modelo y umbral van JUNTOS (ARC-3 en docs/SPEC.md) ---
# v2: recavai-corpus-v2 + intfloat/multilingual-e5-small + 0.841
# v1: uclm-corpus-roma  + sentence-transformers/all-MiniLM-L6-v2 + 0.55
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RAG_MIN_SCORE=0.841

# --- Grafo normativo en memoria (sustituye a Neo4j, retirado el 23/09/2026) ---
# Vacío = desactivado. Si está puesto y no carga, ERROR en el arranque y el servicio sigue sin él.
RAG_NORMATIVE_GRAPH=data/normative_graph.json

# --- Contexto adaptativo (docs/PLAN_CONTEXTO.md, 24/09/2026) ---
# Almacén de unidades (generado desde el índice v2; con el v1, dejarlo vacío).
# Vacío = un bloque por fragmento, 6 como máximo (comportamiento anterior).
RAG_UNIT_STORE=data/unidades.json.gz
# Nivel de contexto máximo: S (6.000 tokens) | M (12.000) | L (45.000, con segunda pasada)
RAG_CONTEXT_MAX_LEVEL=L
# Razonamiento interno de Gemini: 0 = sin razonamiento; vacío = dinámico (más lento)
RAG_THINKING_BUDGET=0
# Planificador de búsqueda (una llamada a flash-lite por pregunta): desactivado
RAG_PLANNER=0

# --- Proyecto GCP para los clientes de BigQuery y Firestore ---
GOOGLE_CLOUD_PROJECT=recava-auditor-dev
GCLOUD_PROJECT=recava-auditor-dev

# --- Servidor local ---
PORT=8080
FLASK_DEBUG=1

# --- Desarrollo local -------------------------------------------------------
# 1 = usa los emuladores de Firebase para Auth y Firestore, de modo que las
#     pruebas NO tocan los datos reales de usuarios ni de conversaciones.
#     Requiere Java instalado:  brew install --cask temurin
# 0 = habla con el Firestore REAL de recava-auditor-dev. Cuidado: los hilos y
#     el progreso de auditoría que crees serán datos de verdad.
USE_EMULATORS=1

# 1 = no escribe trazas en BigQuery (recomendado en local).
DISABLE_BIGQUERY=1

# Orígenes permitidos. El frontend local se sirve en http://localhost:8000.
CORS_ORIGINS=http://localhost:8000,https://recava-auditor-dev.web.app,https://recava-auditor-dev-panel.web.app
