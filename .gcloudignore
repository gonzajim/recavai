# Qué NO se sube a Cloud Build. Sin esto se subirían el entorno virtual (~2 GB con
# torch) y node_modules, haciendo el despliegue lentísimo.
.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]

node_modules/
public/admin-panel/node_modules/
functions/node_modules/

# Secretos y artefactos locales
.env
.firebase/
firestore-debug.log
results/
benchmarks/baseline.jsonl
benchmarks/run_*.jsonl

# Material que no forma parte de la imagen
paper/
docs/
benchmarks/smoke/
*.md
!requirements.txt
# Las habilidades del agente son Markdown pero forman parte del runtime.
!src/agent/skills/*.md
bubble_tmp.bin
temp.js
test_api.ps1
test.orchestrator.http

# Datos de evaluación que no forman parte de la imagen
data/real_queries.jsonl
data/categorias_v1.json
